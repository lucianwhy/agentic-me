# 复制为 .env 后按需填写。没有 API Key 时应用也能启动，聊天会返回中文提示。

# === 大模型（OpenAI 兼容，含 DeepSeek 等） ===
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# DeepSeek 示例：
# LLM_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com
# 也可使用 LLM_BASE_URL，效果相同
OPENAI_API_KEY=
OPENAI_BASE_URL=
# LLM_BASE_URL=

# Embedding（默认走同一套兼容接口；DeepSeek 若无 embedding 请改用 OpenAI 或其他兼容服务）
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=

# === 可选：Ollama（需 pip install langchain-ollama） ===
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODELS=llama3.2

# === 访问控制：留空或 {} 表示公开访问 ===
INVITE_CODES={}

# === 可选重依赖：默认关闭，不安装也不影响启动 ===
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ChatCV
GUARDRAILS_TOKEN=
# MLFLOW_TRACKING_URI=./mlruns

ENVIRONMENT=development
LOG_DIR=./logs
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=true
