# 复制为 .env 后按需填写。没有 API Key 时应用也能启动，聊天会返回中文提示。

# === 大模型（OpenAI 兼容，含 DeepSeek 等） ===
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# 思考强度：none|low|medium|high|xhigh|max（gpt-5.x 等推理模型）
REASONING_EFFORT=medium
# DeepSeek 示例：
# LLM_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com
# 也可使用 LLM_BASE_URL，效果相同
OPENAI_API_KEY=
OPENAI_BASE_URL=
# LLM_BASE_URL=

# Embedding：推荐本地 FastEmbed（无需 embedding API；nuoapi 等代理通常无 embedding 模型）
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 若改用 OpenAI 兼容 embedding API：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=
#
# Volcengine Ark 多模态 Embedding（doubao-embedding-vision）：
# 使用 /embeddings/multimodal（标准 /embeddings 会 400）。需 ARK_API_KEY。
# EMBEDDING_PROVIDER=ark
# EMBEDDING_MODEL=ep-xxxxxxxx-xxxx
# EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_API_KEY=
# # 或 EMBEDDING_API_KEY=（与 ARK_API_KEY 二选一）

# === 可选：Ollama（需 pip install langchain-ollama） ===
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODELS=llama3.2

# === 访问控制：留空或 {} 表示公开访问 ===
INVITE_CODES={}

# === 可选重依赖：默认关闭，不安装也不影响启动 ===
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ChatCV
GUARDRAILS_TOKEN=
# MLFLOW_TRACKING_URI=./mlruns

ENVIRONMENT=development
LOG_DIR=./logs
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=true
